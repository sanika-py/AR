# Source of truth: BRAIN.md
# Streamlit does not require credentials. The API/Docker Compose use JWT_SECRET_KEY.
# This example is not loaded automatically by the Python application.
# To select a local model snapshot, set AWAZRAKSHAK_MODEL_PATH in the process
# environment to a cache root or snapshot containing all pinned, verified files.
# The tracked Models directory currently lacks model.safetensors.
# AWAZRAKSHAK_MODEL_PATH=Models
ASR_ENABLED=false
# When enabled, point to an already-present faster-whisper small model directory.
ASR_MODEL_PATH=
DATABASE_URL=sqlite:///./.awazrakshak-data/awazrakshak.db
# Set to a random secret of at least 32 bytes before using protected REST endpoints.
JWT_SECRET_KEY=
JWT_LIFETIME_MINUTES=30
MODEL_DIR=./models
FRONTEND_PORT=8080
