FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    CUDA_VISIBLE_DEVICES="" \
    AWAZRAKSHAK_MODEL_PATH=/models \
    AWAZRAKSHAK_API_HOST=0.0.0.0 \
    AWAZRAKSHAK_API_PORT=8000

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt
COPY . .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/.awazrakshak-data /app/.cache/hf \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "python -m backend.startup_check && alembic upgrade head && exec uvicorn backend.app:app --host 0.0.0.0 --port 8000"]
